# Copy to .env and fill in.

# BytePlus ModelArk: Seedream 5 Pro (images) + Seedance 2.5 (video)
ARK_API_KEY=
# kie.ai: Seedance 2.5 fallback for faces + GPT Image 2 (merch mockups)
KIE_AI_API_KEY=
# ElevenLabs: narration (v4/v4 Turbo), Voice Design, Voice Changer, Scribe, music, sound effects
ELEVEN_LABS_API_KEY=
# Optional (not used by the current pipeline)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Media bucket (presigned reference URLs + deliveries)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=

# Remotion Lambda (remotion 4.0.486)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_REGION=eu-north-1
REMOTION_LAMBDA_FUNCTION_NAME=   # Remotion Lambda function deployed with remotion 4.0.486
REMOTION_LAMBDA_SERVE_URL=

# HyperFrames Lambda (captions pass; uses the REMOTION_AWS_* identity)
HYPERFRAMES_LAMBDA_REGION=eu-north-1
HYPERFRAMES_LAMBDA_BUCKET=
HYPERFRAMES_LAMBDA_STATE_MACHINE_ARN=
HYPERFRAMES_LAMBDA_MEMORY_MB=10240
